VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Attendance delivery runs in Netlify Functions. Make these available to
# Functions, or make the existing VITE_EMAILJS values available to that scope.
# Allow non-browser API requests in EmailJS Account > Security.
# If private-key authorization is enabled, use the existing private key here.
# Never prefix a private key with VITE_ or commit its real value.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional dedicated attendance template, using the same template parameters.
EMAILJS_ATTENDANCE_TEMPLATE_ID=

VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Optional: use only the real ownership token supplied by Google Search Console.
# Leave empty until that account is connected. The build embeds it in public pages.
GOOGLE_SITE_VERIFICATION=
